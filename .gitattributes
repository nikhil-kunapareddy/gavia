# LF everywhere, including Windows checkouts, so a commit from one system
# never rewrites every line for the others.
* text=auto eol=lf

# Explicitly binary so git never mangles them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mpo binary
*.ico binary
*.icns binary
*.pdf binary
*.zip binary
*.gz binary
*.dmg binary
*.mp4 binary
*.mov binary
*.wav binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Model weights. Committed, not LFS: an offline desktop app has to ship with
# its model, and 36MB is a one-time clone cost.
*.onnx binary

# PowerShell scripts are the one exception.
*.ps1 text eol=crlf
