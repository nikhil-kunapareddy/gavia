# --- Playwright ---
test-results/
playwright-report/
playwright/.cache/

# --- Rust / Tauri backend ---
target/
**/*.rs.bk

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
gavia-venv/
# Project venv (created with `python3 -m venv gavia-venv`). Anchored to the
# repo root so a future source dir of the same name isn't ignored by accident.
/gavia-venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- Swift / Xcode ---
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
.build/
.swiftpm/

# --- App artifacts ---
*.app
*.dmg
*.pkg

# --- Local annotation data ---
# Keep datasets and exported annotations out of the repo.
data/
datasets/
exports/
*.sqlite
*.sqlite3
*.db
