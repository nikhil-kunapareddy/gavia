.vscode/
.idea/
*.swp
*.swo
*~

# --- Env / secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
