# Copy to backend/.env and adjust as needed.
# Every value below is a default; the file only needs the ones you change.

APP_NAME=Gavia API
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Model ---
# MODEL_PATH=models/loon_v1.onnx
# Thresholds default to the model's own sidecar JSON when unset.
# CONFIDENCE_THRESHOLD=0.25
# IOU_THRESHOLD=0.45
# INFERENCE_THREADS=

# --- Tiling ---
# Off by default. It helps only when birds are small relative to the frame;
# on the current dataset most loons are larger than a 640px tile and tiling
# costs far more precision than it gains. Measure with scripts/evaluate.py
# before turning it on.
TILING_ENABLED=false
# TILE_THRESHOLD=1.5
# TILE_OVERLAP=0.2
# MAX_TILES=64

# --- Storage ---
# Defaults to the platform's per-user data directory, e.g. on macOS
# ~/Library/Application Support/Gavia
# DATA_DIR=
# THUMBNAIL_SIZE=320

# --- Uploads ---
# MAX_UPLOAD_BYTES=20971520

# --- Desktop shell ---
# When set, the built frontend is served from / beside the API, putting both
# halves on one origin. The packaged app passes this; in development Vite
# serves the frontend and proxies /api here, so leave it empty.
# STATIC_DIR=

# --- Local service hardening ---
# When set, every /api request except /api/health must send this as
# X-Gavia-Token. Leave empty in development; the desktop shell generates one
# per launch so nothing else on the machine can drive the sidecar.
# AUTH_TOKEN=
